# Copy to secrets.yaml (gitignored) and fill in.
#
# Kein wifi_ssid/wifi_password nötig: das Gerät startet ohne vorkonfiguriertes
# WLAN direkt als eigener Access Point mit Captive Portal, echte Zugangsdaten
# werden erst danach über das Portal eingegeben. Siehe README.

# Passwort für den Access Point, den das Gerät selbst aufspannt (mind. 8 Zeichen).
wifi_ap_password: "geheim123"

# Generieren mit: openssl rand -base64 32
api_encryption_key: "BASE64-ENCRYPTION-KEY-HIER-EINTRAGEN=="

ota_password: "geheim"
